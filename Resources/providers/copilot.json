{
  "schemaVersion": 1,
  "id": "copilot",
  "revision": 2,
  "name": "GitHub Copilot",
  "iconLabel": "GHC",
  "iconColor": "8957E5",
  "source": {
    "type": "command",
    "executable": "gh",
    "args": ["api", "copilot_internal/user"],
    "timeoutSeconds": 20,
    "expect": {
      "require": "/quota_snapshots"
    }
  },
  "map": {
    "plan": { "path": "/copilot_plan" },
    "meters": [
      {
        "select": "/quota_snapshots/chat",
        "match": [{ "path": "/has_quota", "equals": true }, { "path": "/unlimited", "equals": false }],
        "id": "chat",
        "label": { "text": "Chat" },
        "windows": [
          { "id": "current", "used": { "path": "/percent_remaining", "as": "remainingPercent" } }
        ]
      },
      {
        "select": "/quota_snapshots/completions",
        "match": [{ "path": "/has_quota", "equals": true }, { "path": "/unlimited", "equals": false }],
        "id": "completions",
        "label": { "text": "Completions" },
        "windows": [
          { "id": "current", "used": { "path": "/percent_remaining", "as": "remainingPercent" } }
        ]
      },
      {
        "select": "/quota_snapshots/premium_interactions",
        "match": [{ "path": "/has_quota", "equals": true }, { "path": "/unlimited", "equals": false }],
        "id": "premium_interactions",
        "label": { "text": "Premium Interactions" },
        "windows": [
          { "id": "current", "used": { "path": "/percent_remaining", "as": "remainingPercent" } }
        ]
      }
    ]
  },
  "refresh": { "intervalSeconds": 300 }
}
