{
  "schemaVersion":1,"id":"copilot","revision":5,"name":"GitHub Copilot","iconLabel":"GHC","iconColor":"8957E5",
  "accounts":{"source":{"type":"command","executable":"gh","args":["auth","status","--json","hosts"],"timeoutSeconds":20},"each":"/hosts/github.com","id":"/login","match":[{"path":"/state","equals":"success"}]},
  "source":{"type":"command","executable":"powershell.exe","args":["-NoProfile","-NonInteractive","-Command","[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false); $token=(& gh auth token --user $env:AI_USAGE_ACCOUNT 2>$null); if ($LASTEXITCODE -ne 0 -or -not $token) { exit 1 }; $env:GH_TOKEN=$token; $token=$null; & gh api copilot_internal/user; exit $LASTEXITCODE"],"env":{"AI_USAGE_ACCOUNT":"${account}"},"timeoutSeconds":20,"expect":{"require":"/quota_snapshots"}},
  "map":{"plan":{"path":"/copilot_plan"},"meters":[
    {"select":"/quota_snapshots/chat","match":[{"path":"/has_quota","equals":true},{"path":"/unlimited","equals":false}],"id":"chat","label":{"text":"Chat"},"windows":[{"id":"current","used":{"path":"/percent_remaining","as":"remainingPercent"},"resetsAt":{"from":"root","path":"/quota_reset_date_utc","as":"iso8601"}}]},
    {"select":"/quota_snapshots/completions","match":[{"path":"/has_quota","equals":true},{"path":"/unlimited","equals":false}],"id":"completions","label":{"text":"Completions"},"windows":[{"id":"current","used":{"path":"/percent_remaining","as":"remainingPercent"},"resetsAt":{"from":"root","path":"/quota_reset_date_utc","as":"iso8601"}}]},
    {"select":"/quota_snapshots/premium_interactions","match":[{"path":"/entitlement","notEquals":0},{"path":"/unlimited","equals":false}],"id":"premium_interactions","label":{"text":"Premium Interactions"},"windows":[{"id":"current","used":{"path":"/percent_remaining","as":"remainingPercent"},"resetsAt":{"from":"root","path":"/quota_reset_date_utc","as":"iso8601"},"count":{"limit":{"path":"/entitlement"},"remaining":{"path":"/quota_remaining"},"unit":{"text":"credits","match":[{"path":"/token_based_billing","equals":true}]}}}]}
  ]},"refresh":{"intervalSeconds":300}
}
